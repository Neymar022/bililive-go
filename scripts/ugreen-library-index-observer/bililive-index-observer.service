[Unit]
Description=Bililive UGREEN index read-only snapshot
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
EnvironmentFile=/etc/bililive-index-observer.conf
ExecStartPre=+/usr/bin/python3 -B /usr/local/lib/bililive-index-observer/platform_probe.py
ExecStart=/usr/bin/python3 -B /usr/local/lib/bililive-index-observer/observer.py
TimeoutStartSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/bililive-index-observer
WorkingDirectory=/
